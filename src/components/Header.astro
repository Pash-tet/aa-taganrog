---
import { withBase } from "../utils/paths"
import AALogo from "./AALogo.astro"
import { Icon } from "astro-icon/components"
import { getPrimaryPhone } from "../utils/contacts"

const primaryPhone = getPrimaryPhone()

const navLinks = [
  { href: "/", label: "Главная" },
  { href: "/sobraniya/", label: "Собрания" },
  { href: "/novichku/", label: "Новичку" },
  { href: "/rodstvennikam/", label: "Родственникам" },
  { href: "/professionalam/", label: "Профессионалам" },
  { href: "/novosti/", label: "Новости" }
]
---

<header
  class="sticky top-0 z-50 w-full bg-primary text-primary-content shadow-md transition-colors"
>
  <div
    class="mx-auto flex max-w-7xl items-center justify-between gap-2 px-4 py-3 sm:px-6 lg:px-8"
  >
    <!-- Left: Brand / Logo & Title -->
    <a
      href={withBase("/")}
      class="group flex min-w-0 items-center gap-2 no-underline focus-visible:outline-2 focus-visible:outline-offset-4 sm:gap-3"
      aria-label="На главную"
    >
      <AALogo class="h-10 w-10 shrink-0 sm:h-14 sm:w-14" />
      <div class="flex min-w-0 flex-col">
        <div
          class="flex flex-wrap items-baseline gap-x-1 text-sm leading-tight font-bold tracking-tight sm:text-xl lg:text-2xl"
        >
          <span class="border-b-2 border-primary-content pb-0.5">Анонимные</span
          >
          <span>Алкоголики<sup class="text-xs font-normal">®</sup></span>
          <span class="basis-full font-normal opacity-95 sm:basis-auto"
            >Таганрог</span
          >
        </div>
        <div class="hidden text-xs tracking-wide italic opacity-85 sm:block">
          Когда будешь готов принять помощь, найди нас...
        </div>
      </div>
    </a>

    <!-- Right: Desktop Navigation + Theme Toggle -->
    <div class="flex shrink-0 items-center gap-1 xl:gap-4">
      <nav
        class="hidden xl:flex xl:items-center xl:gap-1"
        aria-label="Основная навигация"
      >
        {
          navLinks.map((link) => (
            <a
              href={withBase(link.href)}
              class="btn btn-ghost text-xs font-semibold tracking-wider text-primary-content uppercase btn-sm hover:bg-black/15"
            >
              {link.label}
            </a>
          ))
        }
      </nav>

      <!-- Theme Switcher (DaisyUI swap with accessible toggle and persistent storage) -->
      <label
        class="btn swap btn-circle swap-rotate border-none btn-ghost text-primary-content btn-sm focus-within:outline-2 focus-within:outline-offset-2 hover:bg-black/15"
        title="Переключить тему"
        aria-label="Переключить тему"
      >
        <input
          type="checkbox"
          id="theme-toggle"
          class="sr-only"
          aria-label="Включить темную тему"
        />
        <!-- Sun icon (shown in light mode) -->
        <Icon name="lucide:sun" class="h-5 w-5 swap-off" />
        <!-- Moon icon (shown in dark mode) -->
        <Icon name="lucide:moon" class="h-5 w-5 swap-on" />
      </label>

      <!-- Mobile dropdown menu (HTML details/summary - works without JavaScript) -->
      <details class="dropdown dropdown-end xl:hidden">
        <summary
          class="btn btn-circle border-none btn-ghost text-primary-content btn-sm hover:bg-black/15"
          aria-label="Открыть меню"
        >
          <Icon name="lucide:menu" class="h-6 w-6" />
        </summary>
        <ul
          class="menu dropdown-content z-50 mt-3 w-56 rounded-box border border-base-300 bg-base-200 p-2 text-base-content shadow-xl"
        >
          {
            navLinks.map((link) => (
              <li>
                <a
                  href={withBase(link.href)}
                  class="py-2.5 text-xs font-semibold tracking-wider uppercase hover:bg-base-300/60"
                >
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </details>
    </div>
  </div>

  <!-- Mobile Fixed Contact Bar (Always pinned right under the navbar) -->
  <div
    class="border-t border-primary-content/20 bg-primary/95 px-4 py-2 text-xs text-primary-content backdrop-blur-xs xl:hidden"
  >
    <div
      class="mx-auto flex max-w-7xl flex-wrap items-center justify-between gap-2"
    >
      <div class="flex flex-wrap items-center gap-1.5 font-medium">
        <Icon name="lucide:phone" class="h-3.5 w-3.5 shrink-0 opacity-80" />
        <a
          href="#contacts"
          class="text-[11px] underline decoration-primary-content/40 opacity-90 hover:decoration-primary-content hover:opacity-100"
          title="Перейти к разделу контактов"
        >
          Телефон доверия:
        </a>
        <a
          href={`tel:${primaryPhone.tel}`}
          class="font-bold whitespace-nowrap underline decoration-primary-content/50 hover:opacity-100"
        >
          {primaryPhone.number}
        </a>
      </div>
      <div class="flex items-center gap-1">
        <a
          href="#contacts"
          class="btn btn-ghost text-[11px] text-primary-content btn-xs hover:bg-black/15"
        >
          Контакты
        </a>
        <a
          href={`tel:${primaryPhone.tel}`}
          class="btn inline-flex items-center gap-1 shadow-xs btn-neutral btn-xs"
        >
          <Icon name="lucide:phone-call" class="h-3 w-3" />
          <span>Позвонить</span>
        </a>
      </div>
    </div>
  </div>
</header>

<script is:inline>
  const setupThemeToggle = () => {
    const toggle = document.getElementById("theme-toggle")
    if (!toggle) return

    const currentTheme =
      document.documentElement.getAttribute("data-theme") || "aa-light"
    toggle.checked = currentTheme === "aa-dark"

    toggle.addEventListener("change", (e) => {
      const nextTheme = e.target.checked ? "aa-dark" : "aa-light"
      document.documentElement.setAttribute("data-theme", nextTheme)
      localStorage.setItem("theme", nextTheme)
    })
  }

  const setupMobileMenu = () => {
    const details = document.querySelector("header details.dropdown")
    if (!details) return

    // Close when clicking a link
    details.querySelectorAll("a").forEach((link) => {
      link.addEventListener("click", () => {
        details.removeAttribute("open")
      })
    })

    // Close when clicking outside
    document.addEventListener("click", (e) => {
      if (!details.contains(e.target)) {
        details.removeAttribute("open")
      }
    })
  }

  setupThemeToggle()
  setupMobileMenu()
  document.addEventListener("astro:after-swap", () => {
    setupThemeToggle()
    setupMobileMenu()
  })
</script>
