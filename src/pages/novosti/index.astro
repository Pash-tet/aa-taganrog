---
import { withBase } from "../../utils/paths"
import Layout from "../../layouts/Layout.astro"
import { getCollection } from "astro:content"
import { Icon } from "astro-icon/components"

const allNews = await getCollection("news")
const sortedNews = allNews.sort(
  (a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime()
)

function formatDate(date: Date): string {
  return new Intl.DateTimeFormat("ru-RU", {
    day: "numeric",
    month: "long",
    year: "numeric"
  }).format(date)
}
---

<Layout
  title="Новости — Анонимные Алкоголики Таганрога"
  description="Новости, события и объявления сообщества Анонимных Алкоголиков в Таганроге."
>
  <div class="space-y-8">
    <nav class="text-xs text-base-content/60" aria-label="Хлебные крошки">
      <ol class="flex items-center gap-2">
        <li><a href={withBase("/")} class="link link-hover">Главная</a></li>
        <li>/</li>
        <li class="font-medium text-base-content">Новости</li>
      </ol>
    </nav>

    <header class="space-y-2 border-b border-base-300 pb-4">
      <div
        class="inline-flex items-center gap-2 rounded-full bg-primary/10 px-3 py-1 text-xs font-semibold text-primary"
      >
        <Icon name="lucide:newspaper" class="h-4 w-4" />
        <span>События и объявления</span>
      </div>
      <h1
        class="text-2xl font-bold tracking-tight text-base-content sm:text-3xl lg:text-4xl"
      >
        Новости сообщества АА в Таганроге
      </h1>
      <p class="text-xs text-base-content/70 sm:text-sm">
        Анонсы мероприятий, расписание в праздники, новости Конференции и
        события групп.
      </p>
    </header>

    <div class="space-y-4">
      {
        sortedNews.length === 0 ? (
          <div class="card border border-base-300 bg-base-200/50 p-8 text-center">
            <p class="text-sm text-base-content/70">
              Новостей пока нет. Свежие публикации появятся здесь в ближайшее
              время.
            </p>
          </div>
        ) : (
          sortedNews.map((post) => (
            <article class="card border border-base-300 bg-base-200 shadow-xs transition hover:border-primary/50">
              <div class="card-body space-y-3 p-6">
                <div class="flex flex-wrap items-center gap-3 text-xs text-base-content/60">
                  <time datetime={post.data.pubDate.toISOString()}>
                    {formatDate(post.data.pubDate)}
                  </time>
                  <span>•</span>
                  <span>{post.data.author}</span>
                </div>

                <h2 class="text-lg font-bold text-base-content transition hover:text-primary sm:text-xl">
                  <a href={withBase(`/novosti/${post.id}`)} class="link link-hover">
                    {post.data.title}
                  </a>
                </h2>

                <p class="text-xs leading-relaxed text-base-content/80 sm:text-sm">
                  {post.data.description}
                </p>

                <div class="pt-2">
                  <a
                    href={withBase(`/novosti/${post.id}`)}
                    class="btn -ml-3 inline-flex items-center gap-1.5 btn-ghost text-xs font-semibold text-primary btn-sm hover:bg-primary/10"
                  >
                    <span>Читать полностью</span>
                    <Icon name="lucide:arrow-right" class="h-3.5 w-3.5" />
                  </a>
                </div>
              </div>
            </article>
          ))
        )
      }
    </div>
  </div>
</Layout>
