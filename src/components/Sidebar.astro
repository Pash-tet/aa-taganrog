---
import { Icon } from "astro-icon/components"
import { getCollection } from "astro:content"
import { getContacts } from "../utils/contacts"

const contacts = getContacts()

const allNews = await getCollection("news")
const newsItems = allNews
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime())
  .slice(0, 5)

function formatDate(date: Date): string {
  return new Intl.DateTimeFormat("ru-RU", {
    day: "2-digit",
    month: "2-digit",
    year: "numeric"
  }).format(date)
}
---

<aside
  class="w-full shrink-0 space-y-6 lg:w-72 xl:w-80"
  aria-label="Боковая панель"
>
  <!-- Contacts Card (with aura-glow) -->
  <div class="aura w-full aura-glow text-primary">
    <div class="card border border-base-300 bg-base-200 shadow-xs">
      <div class="card-body p-5">
        <div class="border-b-2 border-primary pb-2 text-center">
          <h2 class="text-sm font-bold tracking-widest text-primary uppercase">
            Контакты
          </h2>
        </div>

        <div class="space-y-3 pt-2 text-center">
          {
            contacts.phones.map((contact) => (
              <div class="flex items-center justify-center">
                <a
                  href={`tel:${contact.tel}`}
                  class="inline-flex link items-center gap-1.5 text-sm font-semibold tracking-wide text-primary link-hover"
                  title={contact.note}
                >
                  <Icon name="lucide:phone" class="h-3.5 w-3.5 opacity-70" />
                  <span>{contact.number}</span>
                </a>
              </div>
            ))
          }

          <!-- Email -->
          <div class="flex items-center justify-center pt-1">
            <a
              href={`mailto:${contacts.email}`}
              class="inline-flex link items-center gap-1.5 text-xs font-semibold text-primary link-hover"
            >
              <Icon name="lucide:mail" class="h-3.5 w-3.5 opacity-70" />
              <span>{contacts.email}</span>
            </a>
          </div>

          <!-- VK Link (Hardcoded) -->
          <div class="border-t border-base-300/60 pt-2">
            <a
              href="https://vk.com/aatag"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex link items-center gap-1.5 text-xs font-bold tracking-wider text-primary uppercase link-hover"
            >
              <Icon name="mdi:vk" class="h-4 w-4" />
              <span>Группа ВКонтакте</span>
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Notice / Tradition (Moved up between Contacts and News, highlighted) -->
  <div
    class="card border border-primary/40 bg-primary/5 p-4 text-center text-xs shadow-xs"
  >
    <div class="flex items-center justify-center gap-1.5 text-primary">
      <Icon name="lucide:shield-check" class="h-4 w-4" />
      <span class="font-bold tracking-wide uppercase">
        Анонимность гарантируется
      </span>
    </div>
    <p class="mt-2 text-xs leading-relaxed text-base-content/80">
      Единственное условие для членства в АА — это желание бросить пить. Никаких
      взносов и списков.
    </p>
  </div>

  <!-- News Card (Dynamic from Content Collections) -->
  <div class="card border border-base-300 bg-base-200 shadow-xs">
    <div class="card-body p-5">
      <div class="border-b-2 border-primary pb-2 text-center">
        <h2 class="text-sm font-bold tracking-widest text-primary uppercase">
          Новости
        </h2>
      </div>

      {
        newsItems.length === 0 ? (
          <p class="py-4 text-center text-xs text-base-content/60">
            Новостей пока нет
          </p>
        ) : (
          <>
            <div class="divide-y divide-base-300 pt-1">
              {newsItems.map((item) => (
                <article class="py-3 text-center first:pt-2 last:pb-1">
                  <a
                    href={`/novosti/${item.id}`}
                    class="block link text-xs leading-snug font-medium text-base-content link-hover hover:text-primary"
                  >
                    {item.data.title}
                  </a>
                  <time class="mt-1 block text-[11px] text-base-content/60">
                    {formatDate(item.data.pubDate)}
                  </time>
                </article>
              ))}
            </div>

            <div class="border-t border-base-300/60 pt-3 text-center">
              <a
                href="/novosti"
                class="[11px]semiboldblock link text-xs leading-snug font-medium text-base-content link-hover hover:text-primary"
              >
                Все новости →
              </a>
            </div>
          </>
        )
      }
    </div>
  </div>
</aside>
