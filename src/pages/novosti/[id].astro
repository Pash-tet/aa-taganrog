---
import { withBase } from "../../utils/paths"
import Layout from "../../layouts/Layout.astro"
import { getCollection, render } from "astro:content"
import { Icon } from "astro-icon/components"

export async function getStaticPaths() {
  const posts = await getCollection("news")
  return posts.map((post) => ({
    params: { id: post.id },
    props: { post }
  }))
}

const { post } = Astro.props
const { Content } = await render(post)

function formatDate(date: Date): string {
  return new Intl.DateTimeFormat("ru-RU", {
    day: "numeric",
    month: "long",
    year: "numeric"
  }).format(date)
}
---

<Layout
  title={`${post.data.title} — Анонимные Алкоголики Таганрога`}
  description={post.data.description}
  image={post.data.image}
  publishedTime={post.data.pubDate.toISOString()}
>
  <article class="space-y-6">
    <nav class="text-xs text-base-content/60" aria-label="Хлебные крошки">
      <ol class="flex items-center gap-2">
        <li><a href={withBase("/")} class="link link-hover">Главная</a></li>
        <li>/</li>
        <li><a href={withBase("/novosti")} class="link link-hover">Новости</a></li>
        <li>/</li>
        <li class="line-clamp-1 font-medium text-base-content">
          {post.data.title}
        </li>
      </ol>
    </nav>

    <header class="space-y-3 border-b border-base-300 pb-4">
      <div class="flex items-center gap-3 text-xs text-base-content/60">
        <time datetime={post.data.pubDate.toISOString()}>
          {formatDate(post.data.pubDate)}
        </time>
        <span>•</span>
        <span>{post.data.author}</span>
      </div>
      <h1
        class="text-2xl font-bold tracking-tight text-base-content sm:text-3xl lg:text-4xl"
      >
        {post.data.title}
      </h1>
    </header>

    {
      post.data.image && (
        <div class="overflow-hidden rounded-xl border border-base-300">
          <img
            src={withBase(post.data.image)}
            alt={post.data.title}
            class="max-h-96 w-full object-cover"
          />
        </div>
      )
    }

    <div class="article-content text-sm leading-relaxed sm:text-base">
      <Content />
    </div>

    <div
      class="flex items-center justify-between border-t border-base-300 pt-6"
    >
      <a
        href={withBase("/novosti")}
        class="btn inline-flex items-center gap-1.5 btn-ghost text-primary btn-sm"
      >
        <Icon name="lucide:arrow-left" class="h-4 w-4" />
        <span>Ко всем новостям</span>
      </a>
      <a href={withBase("/sobraniya")} class="btn btn-neutral btn-sm">
        Расписание собраний
      </a>
    </div>
  </article>
</Layout>

<style is:global>
  .article-content {
    color: var(--color-base-content);
  }
  .article-content h2 {
    font-size: 1.5rem;
    font-weight: 700;
    margin-top: 1.75rem;
    margin-bottom: 0.75rem;
    line-height: 1.3;
  }
  .article-content h3 {
    font-size: 1.25rem;
    font-weight: 700;
    margin-top: 1.5rem;
    margin-bottom: 0.5rem;
    line-height: 1.3;
  }
  .article-content p {
    margin-bottom: 1rem;
    line-height: 1.7;
    opacity: 0.9;
  }
  .article-content ul {
    list-style-type: disc;
    padding-left: 1.5rem;
    margin-bottom: 1rem;
    line-height: 1.7;
    opacity: 0.9;
  }
  .article-content ol {
    list-style-type: decimal;
    padding-left: 1.5rem;
    margin-bottom: 1rem;
    line-height: 1.7;
    opacity: 0.9;
  }
  .article-content li {
    margin-bottom: 0.35rem;
  }
  .article-content blockquote {
    border-left: 4px solid var(--color-primary);
    padding: 0.5rem 0 0.5rem 1rem;
    margin: 1.25rem 0;
    font-style: italic;
    opacity: 0.85;
    background: color-mix(in srgb, var(--color-primary) 5%, transparent);
    border-radius: 0 0.5rem 0.5rem 0;
  }
  .article-content a {
    color: var(--color-primary);
    text-decoration: underline;
  }
  .article-content a:hover {
    opacity: 0.8;
  }
  .article-content img {
    border-radius: 0.75rem;
    border: 1px solid var(--color-base-300);
    margin: 1.5rem 0;
    max-width: 100%;
    height: auto;
  }
</style>
